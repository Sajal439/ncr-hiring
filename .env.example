# Map tiles. Defaults to OpenStreetMap when unset.
# NEXT_PUBLIC_TILE_URL=https://api.maptiler.com/maps/dataviz/{z}/{x}/{y}.png?key=YOUR_KEY

# Where /api/submit forwards new company submissions.
# SUBMIT_WEBHOOK_URL=https://hooks.slack.com/services/...

# The only paid source. console.apify.com -> Settings -> API & Integrations.
# Store it with no trailing newline; a stray \n reads as an invalid token:
#   printf %s "apify_api_..." | gh secret set APIFY_TOKEN
# Verify with: node scripts/check-apify.mjs
# APIFY_TOKEN=apify_api_...

# Free jobs API. developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Daily digest — subscriber store.
# A Google Sheet behind an Apps Script web app; see
# google-apps-script/subscribers.gs for the three-minute setup.
# Needed by Vercel (signup + unsubscribe) and GitHub Actions (sending).
# SUBSCRIBERS_URL=https://script.google.com/macros/s/.../exec
# SUBSCRIBERS_TOKEN=

# Daily digest — sending. Set ONE of the two blocks below; SMTP wins if both.
#
# Gmail SMTP. The one that works with no domain, ~500 recipients/day. SMTP_PASS
# is a Google *app password* (Account -> Security -> 2-Step Verification ->
# App passwords), never the account password.
# SMTP_USER=ncrstartupmap@gmail.com
# SMTP_PASS=
#
# Resend. Better long-term, but onboarding@resend.dev only delivers to your own
# account address, so DIGEST_FROM must be on a domain verified with Resend
# before this can reach a single subscriber.
# RESEND_API_KEY=
# DIGEST_FROM=NCR Startup Map <jobs@yourdomain.com>
# SITE_URL=https://delhi-ncr-startup-map.vercel.app

# Hiring posts (scripts/fetch-hr-posts.mjs) reuse APIFY_TOKEN. Nothing extra.

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX.
# Set on Vercel production only — leaving it unset here keeps local runs and
# preview deploys out of the numbers.
NEXT_PUBLIC_GA_ID=
